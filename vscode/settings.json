{
  // ============================================================================
  // VS Code user settings tailored for Java + Kotlin + Spring Boot + PostgreSQL
  // + Git development. Applied by install.ps1 to %APPDATA%\Code\User\settings.json.
  // ============================================================================
  // ---- Editor ----
  "editor.formatOnSave": true,
  "editor.rulers": [
    120
  ],
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.exclude": {
    // Hide common Java/Gradle/Maven build output from the explorer.
    "**/target": true,
    "**/build": true,
    "**/.gradle": true,
    "**/bin": true,
    "**/.settings": true,
    "**/.classpath": true,
    "**/.project": true
  },
  "workbench.editor.enablePreview": false,
  "explorer.confirmDelete": false,
  // ---- Java (Extension Pack for Java / redhat.java language server) ----
  // No fixed java.jdt.ls.java.home here on purpose: the active JDK is resolved
  // via JAVA_HOME, which jabba manages. Switching JDKs with `jabba use <x>`
  // is picked up automatically - just restart VS Code after switching.
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.compile.nullAnalysis.mode": "automatic",
  "java.jdt.ls.lombokSupport.enabled": true,
  "[java]": {
    "editor.tabSize": 4,
    "editor.defaultFormatter": "redhat.java"
  },
  // ---- Kotlin (Kotlin by JetBrains) ----
  "[kotlin]": {
    "editor.tabSize": 4
  },
  // ---- Git ----
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "gitlens.codeLens.enabled": false,
  "intellij.region": "americas",
  "intellij.dataSharing": "none" // reduce visual noise; set true if you like inline blame
}
